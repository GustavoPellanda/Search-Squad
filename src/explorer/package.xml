<?xml version="1.0"?>
<package format="3">
  <name>explorer</name>
  <version>0.1.0</version>
  <description>Bounded reactive LiDAR demonstration for one explorer.</description>
  <maintainer email="gusfipe@gmail.com">Gustavo Pellanda</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
