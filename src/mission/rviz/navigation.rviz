Panels:
- Class: rviz_common/Displays
  Name: Displays
- Class: rviz_common/Tool Properties
  Name: Tool Properties
- Class: nav2_rviz_plugins/Navigation 2
  Name: Navigation 2
Visualization Manager:
  Class: ''
  Global Options:
    Fixed Frame: map
    Frame Rate: 20
  Displays:
  - Class: rviz_default_plugins/RobotModel
    Name: scout
    Enabled: true
    Description Source: Topic
    Description Topic:
      Value: /scout/robot_description
      Durability Policy: Transient Local
    TF Prefix: scout
  - Class: rviz_default_plugins/RobotModel
    Name: explorer_1
    Enabled: true
    Description Source: Topic
    Description Topic:
      Value: /explorer_1/robot_description
      Durability Policy: Transient Local
    TF Prefix: explorer_1
  - Class: rviz_default_plugins/RobotModel
    Name: explorer_2
    Enabled: true
    Description Source: Topic
    Description Topic:
      Value: /explorer_2/robot_description
      Durability Policy: Transient Local
    TF Prefix: explorer_2
  - Class: rviz_default_plugins/Map
    Name: Live observed map
    Enabled: true
    Topic:
      Value: /map
      Durability Policy: Transient Local
  - Class: rviz_default_plugins/Map
    Name: Global costmap
    Enabled: false
    Color Scheme: costmap
    Topic:
      Value: /explorer_1/nav2/global_costmap/costmap
      Durability Policy: Transient Local
  - Class: rviz_default_plugins/Path
    Name: Nav2 route
    Enabled: true
    Topic:
      Value: /explorer_1/nav2/plan
      Durability Policy: Volatile
  - Class: rviz_default_plugins/MarkerArray
    Name: Room and frontiers
    Enabled: true
    Topic:
      Value: /explorer_1/room_markers
      Durability Policy: Transient Local
  - Class: rviz_default_plugins/PointCloud2
    Name: Fleet LiDAR observations
    Enabled: true
    Size (m): 0.025
    Topic:
      Value: /mapping/scan_points
      Reliability Policy: Best Effort
  - Class: rviz_default_plugins/TF
    Name: TF
    Enabled: false
  Tools:
  - Class: rviz_default_plugins/Interact
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/SetGoal
    Topic:
      Value: goal_pose
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Scale: 65
      X: -2
      Y: 2
Window Geometry:
  Width: 1150
  Height: 850
