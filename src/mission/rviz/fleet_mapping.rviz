Panels:
- Class: rviz_common/Displays
  Name: Displays
Visualization Manager:
  Class: ''
  Global Options:
    Fixed Frame: map
    Background Color: 40; 40; 40
    Frame Rate: 20
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Grid
    Enabled: true
    Cell Size: 1
  - Class: rviz_default_plugins/Map
    Name: Shared structural map
    Enabled: true
    Topic:
      Value: /map
      Durability Policy: Transient Local
      Reliability Policy: Reliable
    Alpha: 0.6
  - Class: rviz_default_plugins/RobotModel
    Name: Scout
    Enabled: true
    Description Source: Topic
    Description Topic:
      Value: /scout/robot_description
      Durability Policy: Transient Local
    TF Prefix: scout
  - Class: rviz_default_plugins/LaserScan
    Name: Raw LiDAR
    Enabled: true
    Topic:
      Value: /scout/scan
      Reliability Policy: Best Effort
    Size (m): 0.025
  - Class: rviz_default_plugins/MarkerArray
    Name: Corridor walls axis and openings
    Enabled: true
    Topic:
      Value: /scout/corridor_markers
      Reliability Policy: Reliable
  - Class: rviz_default_plugins/MarkerArray
    Name: Confirmed room entrances
    Enabled: true
    Topic:
      Value: /fleet/markers
      Durability Policy: Transient Local
      Reliability Policy: Reliable
  - Class: rviz_default_plugins/Polygon
    Name: Physical footprint stop zone
    Enabled: true
    Topic:
      Value: /scout/stop_zone
  - Class: rviz_default_plugins/RobotModel
    Name: explorer_1
    Enabled: true
    Description Source: Topic
    Description Topic:
      Value: /explorer_1/robot_description
      Durability Policy: Transient Local
    TF Prefix: explorer_1
  - Class: rviz_default_plugins/Path
    Name: explorer_1 Nav2 route
    Enabled: true
    Topic:
      Value: /explorer_1/nav2/plan
      Reliability Policy: Reliable
      Durability Policy: Volatile
    Color: 30; 170; 255
    Line Style: Billboards
    Line Width: 0.04
  - Class: rviz_default_plugins/RobotModel
    Name: explorer_2
    Enabled: true
    Description Source: Topic
    Description Topic:
      Value: /explorer_2/robot_description
      Durability Policy: Transient Local
    TF Prefix: explorer_2
  - Class: rviz_default_plugins/Path
    Name: explorer_2 Nav2 route
    Enabled: true
    Topic:
      Value: /explorer_2/nav2/plan
      Reliability Policy: Reliable
      Durability Policy: Volatile
    Color: 255; 120; 30
    Line Style: Billboards
    Line Width: 0.04
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Scale: 60
      Target Frame: map
      X: 4.0
      Y: 0.0
Window Geometry:
  Width: 1200
  Height: 850
