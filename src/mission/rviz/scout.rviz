Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: scout/odom
    Background Color: 40; 40; 40
    Frame Rate: 20
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
    - Class: rviz_default_plugins/RobotModel
      Name: scout
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /scout/robot_description
        Durability Policy: Transient Local
      TF Prefix: scout
    - Class: rviz_default_plugins/LaserScan
      Name: LiDAR
      Enabled: true
      Topic:
        Value: /scout/scan
        Reliability Policy: Best Effort
      Size (m): 0.025
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
    - Class: rviz_default_plugins/Polygon
      Name: Stop zone
      Enabled: true
      Topic:
        Value: /scout/stop_zone
    - Class: rviz_default_plugins/Polygon
      Name: Slow zone
      Enabled: true
      Topic:
        Value: /scout/slow_zone
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Scale: 80
      Target Frame: scout/base_footprint
Window Geometry:
  Width: 1100
  Height: 800
